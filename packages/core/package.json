{
  "name": "@bleepit/core",
  "version": "0.2.1",
  "description": "Keep profanity out of your product. Fast profanity checker with wordlists you control. Zero dependencies, isomorphic (Node/Browser/Deno/Bun/Workers).",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alekslinde/bleepit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/alekslinde/bleepit#readme",
  "bugs": "https://github.com/alekslinde/bleepit/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./lists": {
      "types": "./dist/lists/index.d.ts",
      "import": "./dist/lists/index.js",
      "require": "./dist/lists/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest run --run test/bench.test.ts",
    "size": "pnpm build && gzip-size dist/index.js",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "profanity",
    "filter",
    "censor",
    "aho-corasick",
    "multilingual",
    "zero-dependency",
    "isomorphic"
  ]
}
